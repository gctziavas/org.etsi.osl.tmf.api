@startuml example-aimodel-mistral

skinparam backgroundColor #FEFEFE
skinparam roundcorner 10
skinparam shadowing false
skinparam maxMessageSize 150

skinparam class {
    BackgroundColor<<Model>> #FFF3E0
    BackgroundColor<<Specification>> #E3F2FD
    BackgroundColor<<Characteristics>> #E8F5E9
    BorderColor #424242
    ArrowColor #424242
    FontSize 9
}

title Mistral-7B Model Example (Specification-Aligned)

class "AiModel: mistralai/Mistral-7B-v0.1" as model <<Model>> {
    + name: "mistralai/Mistral-7B-v0.1"
    + description: "Mistral 7B v0.1 - 7B parameter language model"
    + version: "0.1"
    + lifecycleStatus: "Active"
    --
    **References AiModelSpecification:**
    + "HuggingFace Platform v1.0"
}

class "Service Characteristics (15 total)" as chars <<Characteristics>> {
    **Specification Characteristics (1-8):**
    ====
    platformUrl: "https://huggingface.co/mistralai/Mistral-7B-v0.1"
    apiUrl: "https://huggingface.co/api/models/mistralai/Mistral-7B-v0.1"  
    modelType: "text-generation"
    supportedLibraries: "transformers"
    provider: "mistralai"
    deploymentArtifactsUrl: "/tmf-api/aim/v1/aiModel/artifacts/..."
    totalSize (in bytes): "14483963727"
    tags: "text-generation,transformers,pytorch,..."
    --
    **TMF 915 Standard Fields (7 total):**
    ====
    modelDataSheet: "https://huggingface.co/mistralai/Mistral-7B-v0.1"
    deploymentRecord: "https://api-inference.huggingface.co/models/..."
    inheritedModel: "mistralai/Mistral-7B-base"
    inheritedModelUrl: "https://huggingface.co/mistralai/Mistral-7B-base"
    modelTrainingData: "wikipedia,bookcorpus,openwebtext2"
    modelTrainingDataUrls: "https://huggingface.co/datasets/wikipedia"
    modelEvaluationData: "mmlu,hellaswag,arc"
}

model *-- chars : contains >

note top of chars
  **Characteristic Organization:**
  
  **Specification Characteristics (8)** - Match platform specification template
  **TMF 915 Standard Fields (7)** - Model card, training data, deployment records
  
  Total: 15 characteristics aligned with specification structure
end note

note bottom of model
  This example shows how a specific HuggingFace model
  (Mistral-7B-v0.1) is structured with characteristics
  aligned to the platform specification.
  
  The first 8 characteristics match the specification
  template, ensuring consistency across all models
  on the HuggingFace platform.
end note

@enduml
