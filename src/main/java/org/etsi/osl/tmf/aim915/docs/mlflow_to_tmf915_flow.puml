@startuml MLflow-to-TMF915-Integration-Flow
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam swimlaneBorderColor #888888
skinparam padding 2
skinparam noteFontSize 9

skinparam swimlane {
  titleFontSize 12
  titleFontStyle bold
}

title MLflow to TMF 915 Integration Flow

|#E3F2FD| MLflow |
|#E8F5E9| TMF API |
|#FFF3E0| Mapping |
|#FCE4EC| Docker |

' ============================================
' IMPORT FLOW
' ============================================

|#E3F2FD| MLflow |
start
:Register Model and Version;

|#E8F5E9| TMF API |
:MlflowIntegrationService\n.importModelAsSpecification();

|#FFF3E0| Mapping |
:MlflowClientService\nfetch Model, Version, Run;
:MlflowSpecificationService\nbuildSpecificationCreate();
note right
  name, version, description
  specCharacteristic:
  - lifecycleStatus, stage
  - runId, createdBy
  - creationTimestamp
  - modelType, framework
  - param_*, metric_*
  URLs: dataSheet,
  trainingData, evalData
end note

|#E8F5E9| TMF API |
:Persist AiModelSpecification;
:Return Specification;

' ============================================
' DOCKER DEPLOYMENT FLOW
' ============================================

|#E8F5E9| TMF API |
:MlflowIntegrationService\n.deployModelFromMlflow();

|#FFF3E0| Mapping |
:MlflowModelService\n.createReservedAiModel();
:Check specification exists\n(import if needed);
:Build AiModelCreate;
note right
  state = **RESERVED**
  characteristic:
  - platform: mlflow
  - deploymentTarget: docker
  - mlflowModelName
  - mlflowModelVersion
end note

|#E8F5E9| TMF API |
:Persist AiModel (RESERVED);
:Return Model with ID;

|#FFF3E0| Mapping |
:MlflowModelService\n.deployAndActivate();

|#FCE4EC| Docker |
:DockerDeploymentService\n.deployModel();
:Find available port;
:Create container via\nDocker Remote API;
:Start container;
:Wait for health check;
:Return ContainerDeploymentInfo;
note right
  containerId
  containerName
  inferenceUrl
  dockerHost
  hostPort
end note

|#FFF3E0| Mapping |
:Update AiModel with\ndeployment info;
note right
  Add characteristics:
  - endpoint: inferenceUrl
  - containerId
  - containerName
  - dockerHost
  - hostPort
  - deployedAt
end note

|#E8F5E9| TMF API |
:Update AiModel state;
:state = **ACTIVE**;

|#FCE4EC| Docker |
:Container serving at\ninferenceUrl/invocations;

' ============================================
' EXTERNAL REGISTRATION FLOW
' ============================================

|#E8F5E9| TMF API |
:Alternative: External Deployment;
:MlflowIntegrationService\n.createModelInstance();

|#FFF3E0| Mapping |
:MlflowModelService\n.createModelInstance();
:Build AiModelCreate with\nexternal endpoint;

|#E8F5E9| TMF API |
:Persist AiModel;
:Return Model;

' ============================================
' STOP DEPLOYMENT FLOW
' ============================================

|#E8F5E9| TMF API |
:MlflowIntegrationService\n.stopDeployment(uuid);

|#FFF3E0| Mapping |
:MlflowModelService\n.stopDeploymentAndTerminate();

|#FCE4EC| Docker |
:DockerDeploymentService\n.stopDeployment();
:Stop container;
:Remove container;
:Update tracking map;

|#E8F5E9| TMF API |
:Update AiModel state;
:state = **TERMINATED**;

stop

' ============================================
' LIFECYCLE STATE DIAGRAM
' ============================================

note as N1
  **AiModel Lifecycle States:**
  
  1. **RESERVED** - Model created, deployment pending
  2. **ACTIVE** - Container running and serving
  3. **TERMINATED** - Container stopped
  
  Flow: RESERVED → ACTIVE → TERMINATED
end note

@enduml
