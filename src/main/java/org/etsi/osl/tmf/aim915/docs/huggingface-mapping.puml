@startuml huggingface-mapping

!define RECTANGLE class

skinparam backgroundColor #FEFEFE
skinparam roundcorner 10
skinparam shadowing false

skinparam class {
    BackgroundColor<<Platform>> #E3F2FD
    BackgroundColor<<Model>> #FFF3E0
    BackgroundColor<<Service>> #F3E5F5
    BackgroundColor<<TMF>> #E8F5E9
    BorderColor #424242
    ArrowColor #424242
}

title HuggingFace Hub Integration with TMF 915 AI Model Management API

package "TMF 915 API" <<TMF>> {
    class "AiModelSpecification" as spec {
        + id: String
        + name: String = "HuggingFace Platform"
        + version: String = "1.0"
        + description: String
        --
        **Platform Characteristics:**
        + platformUrl: String
        + apiUrl: String
        + supportedModelTypes: Array
        + supportedLibraries: Array
        + licenseTypes: Array
        + accessTypes: Array
        + deploymentArtifactsInfo: String
    }
    
    class "AiModel" as model {
        + id: String
        + name: String (modelId)
        + description: String
        + aiModelSpecification: Reference
        --
        **Service Characteristics:**
        + modelId: String
        + repositoryUrl: String
        + modelType: String
        + library: String
        + author: String
        + lastModified: DateTime
        + tags: Array
        + totalSize: Integer
        + totalSizeHuman: String
        + languages: Array
        --
        **TMF Standard Fields:**
        + modelDataSheet: String
        + inheritedModel: String
        + inheritedModelUrl: String
        + trainingData: String
        + trainingDataUrl: String
        + evaluationData: String
        + deploymentRecord: String
        + deploymentArtifactsUrl: String
    }
}

package "HuggingFace Hub" <<Platform>> {
    class "HuggingFace API" as hfapi {
        **Endpoints:**
        + GET /api/models/{modelId}
        + GET /api/models?search=query
        + GET /{modelId}/resolve/main/{file}
        --
        **Response Fields:**
        - id (modelId)
        - author
        - pipeline_tag
        - library_name
        - tags[]
        - lastModified
        - cardData
        - siblings[] (files)
    }
    
    class "Model Files" as files {
        **Essential Files:**
        - config.json
        - tokenizer_config.json
        - tokenizer.json
        - special_tokens_map.json
        - vocab.txt / vocab.json
        - merges.txt
        - *.safetensors
        - *.bin (PyTorch)
        - *.onnx
    }
}

package "Integration Service" <<Service>> {
    class "HuggingFacePlatformService" as service {
        + getOrCreatePlatformSpecification()
        + huggingFaceModelToAiModelCreate()
        + searchModels()
        + validateModelExists()
        + downloadDeploymentArtifactsAsTargz()
        + streamDeploymentArtifactsAsTargz()
    }
    
    class "HuggingFacePlatformUtils" as utils {
        **Constants:**
        + HF_API_BASE_URL
        + HF_HUB_URL
        --
        **Helpers:**
        + createCharacteristicSpec()
        + addCharacteristic()
        + getTextValue()
        + extractTags()
        + extractLanguages()
        + calculateTotalSize()
        + formatBytes()
        --
        **URL Builders:**
        + buildRepositoryUrl()
        + buildDatasetUrl()
        + buildInferenceApiUrl()
        + buildDeploymentArtifactsUrl()
        --
        **File Handling:**
        + getEssentialDeploymentFiles()
    }
    
    class "ArtifactController" as controller {
        + GET /artifacts/huggingface/{modelId}/deployment.tar.gz
        --
        **Features:**
        - On-demand tar.gz creation
        - In-memory processing (no disk)
        - Streaming for large models
        - Proper POSIX tar format
    }
}

' Relationships
spec "1" -- "0..*" model : specifies
model --> spec : references

hfapi --> service : provides data
files --> service : provides files

service ..> spec : creates/retrieves
service ..> model : creates
service --> utils : uses
service --> controller : provides files to

controller --> files : downloads
controller ..> model : serves artifacts for

note right of spec
    **Single Platform Specification**
    - One specification for HuggingFace Hub
    - Defines platform-wide capabilities
    - Static characteristics
end note

note right of model
    **Multiple Model Instances**
    - One AiModel per HuggingFace model
    - Dynamic characteristics per model
    - References platform specification
    - Examples:
      * mistralai/Mistral-7B-v0.1
      * gpt2
      * bert-base-uncased
end note

note bottom of service
    **Mapping Logic**
    1. Fetch model info from HuggingFace API
    2. Extract characteristics using Utils
    3. Create AiModel with platform spec reference
    4. Map TMF fields: modelDataSheet, trainingData, etc.
    5. Add deploymentArtifactsUrl for tar.gz download
end note

note bottom of controller
    **Artifact Creation**
    1. Receive request with model ID
    2. Download essential files from HuggingFace
    3. Create tar.gz archive in memory
    4. Stream response (no disk storage)
    5. Apache Commons Compress for proper tar format
end note

@enduml
