@startuml huggingface-platform-specification

!define RECTANGLE class

skinparam backgroundColor #FEFEFE
skinparam roundcorner 10
skinparam shadowing false

skinparam class {
    BackgroundColor<<Specification>> #E3F2FD
    BackgroundColor<<Characteristic>> #FFF3E0
    BorderColor #424242
    ArrowColor #424242
}

title HuggingFace Platform Specification (TMF 915)

class "AiModelSpecification" as spec <<Specification>> {
    **Metadata**
    --
    + id: UUID
    + name: "HuggingFace Platform"
    + version: "1.0"
    + @type: "AiModelSpecification"
    + @schemaLocation: "https://tmforum.org/schemas/aim915/AiModelSpecification"
    --
    **Description**
    Hugging Face Hub - A platform for hosting 
    and sharing AI models, particularly for NLP, 
    computer vision, and other ML tasks.
    Supports Transformers, Diffusers, and more.
}

class "Characteristic 1: platformUrl" as char1 <<Characteristic>> {
    + name: "platformUrl"
    + description: "Base URL for the Hugging Face Hub platform"
    + valueType: string
    + value: "https://huggingface.co"
    + isDefault: true
}

class "Characteristic 2: apiUrl" as char2 <<Characteristic>> {
    + name: "apiUrl"
    + description: "Base URL for the Hugging Face API"
    + valueType: string
    + value: "https://huggingface.co/api"
    + isDefault: true
}

class "Characteristic 3: supportedModelTypes" as char3 <<Characteristic>> {
    + name: "supportedModelTypes"
    + description: "Types of models supported by the platform"
    + valueType: array
    + isDefault: true
    --
    **Values:**
    - text-generation
    - text-classification
    - token-classification
    - question-answering
    - translation
    - summarization
    - conversational
    - text-to-image
    - image-classification
    - object-detection
    - image-segmentation
    - audio-classification
    - automatic-speech-recognition
    - text-to-speech
    - fill-mask
    - sentence-similarity
}

class "Characteristic 4: supportedLibraries" as char4 <<Characteristic>> {
    + name: "supportedLibraries"
    + description: "Machine learning libraries supported"
    + valueType: array
    + isDefault: true
    --
    **Values:**
    - transformers
    - diffusers
    - sentence-transformers
    - timm
    - spacy
    - paddlenlp
    - tensorflowjs
    - fairseq
    - asteroid
    - speechbrain
    - espnet
    - allennlp
}

class "Characteristic 5: licenseTypes" as char5 <<Characteristic>> {
    + name: "licenseTypes"
    + description: "Types of licenses available on the platform"
    + valueType: array
    + isDefault: true
    --
    **Values:**
    - apache-2.0
    - mit
    - openrail
    - creativeml-openrail-m
    - bigscience-bloom-rail-1.0
    - bigscience-openrail-m
    - cc-by-4.0
    - cc-by-nc-4.0
    - cc-by-sa-4.0
    - gpl-3.0
    - lgpl-3.0
    - other
}

class "Characteristic 6: accessTypes" as char6 <<Characteristic>> {
    + name: "accessTypes"
    + description: "Model access levels supported by the platform"
    + valueType: array
    + isDefault: true
    --
    **Values:**
    - public
    - private
    - gated
}

class "Characteristic 7: deploymentArtifactsInfo" as char7 <<Characteristic>> {
    + name: "deploymentArtifactsInfo"
    + description: "Information about downloadable deployment artifacts"
    + valueType: string
    + isDefault: true
    --
    **Value:**
    Each model provides a deploymentArtifactsUrl 
    characteristic that points to a tar.gz archive 
    containing all essential files needed for 
    deployment (config, tokenizer, weights, etc.). 
    Archives are created on-demand and served 
    via the TMF API.
}

spec "1" *-- "7" char1 : specCharacteristic >
spec "1" *-- "7" char2 : specCharacteristic >
spec "1" *-- "7" char3 : specCharacteristic >
spec "1" *-- "7" char4 : specCharacteristic >
spec "1" *-- "7" char5 : specCharacteristic >
spec "1" *-- "7" char6 : specCharacteristic >
spec "1" *-- "7" char7 : specCharacteristic >

note right of spec
    **Single Platform Specification**
    - Represents HuggingFace Hub as a platform
    - All HuggingFace models reference this spec
    - 7 characteristics define platform capabilities
    - Static specification (version 1.0)
end note

note bottom of char1
    **Platform URLs**
    - Hub: https://huggingface.co
    - API: https://huggingface.co/api
end note

note bottom of char3
    **16 Model Types Supported**
    Covers NLP, vision, audio, 
    and multimodal tasks
end note

note bottom of char4
    **12 Libraries Supported**
    Major ML frameworks including
    Transformers, Diffusers, etc.
end note

note bottom of char7
    **On-Demand Artifacts**
    - No disk storage
    - tar.gz format
    - Essential files only
    - Streamed for large models
end note

@enduml
